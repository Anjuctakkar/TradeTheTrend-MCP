# Local use: cp .env.local.example .env
# With GOOGLE_CLIENT_ID empty there is no login: you run as one local admin and data stays in app.db here.
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

# To try Google sign-in on your own computer, fill in these four (DEPLOY.md step 2) and add
# http://localhost:8000 and http://127.0.0.1:8000 as authorized JavaScript origins:
GOOGLE_CLIENT_ID=
DASHBOARD_SECRET=
ADMIN_EMAILS=
ALLOWED_EMAILS=
