# Copy to .env on the server:   cp .env.production.example .env   then fill it in and keep it private:  chmod 600 .env
# Put comments on their own lines (not after a value): Docker Compose does not strip trailing comments.

# ---- Your public address, without https:// (Docker + Caddy route only; used for the HTTPS certificate)
DOMAIN=app.yourdomain.com

# ---- Database (Docker route). Use a long random value with only letters and digits:  openssl rand -hex 24
POSTGRES_USER=nse
POSTGRES_PASSWORD=
POSTGRES_DB=nse
# Render and no-Docker routes set DATABASE_URL instead (Render fills it in for you):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ---- Sign in with Google (see DEPLOY.md step 2)
GOOGLE_CLIENT_ID=
# Signs the session cookie, at least 32 characters:  openssl rand -hex 32   (changing it signs everyone out)
DASHBOARD_SECRET=
# Who may sign in (comma separated). Admins are always allowed and can use Settings and the admin pages.
ADMIN_EMAILS=you@gmail.com
ALLOWED_EMAILS=
ALLOWED_DOMAINS=
# 1 = anyone with a verified Google account may sign up. Leave empty for an invite-only service.
OPEN_SIGNUP=
DASHBOARD_SESSION_HOURS=12

# ---- The chat assistant
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
# Per signed-in user:
AGENT_USER_RATE_PER_10MIN=15
AGENT_USER_DAILY_CAP=100
AGENT_USER_MAX_INFLIGHT=2
# All users together per day (your overall cost ceiling):
AGENT_DAILY_CAP=500

# ---- NSE connection and the shared cache (defaults shown)
# NSE_READ_TIMEOUT=60
# NSE_RETRIES=1
# NSE_MAX_INFLIGHT=4
# Big scans (Suggest stocks) allowed to run at once across all users:
# NSE_HEAVY_JOBS=2
# Shared cache: 1 = on, 0 = off. Live quotes live this many seconds:
# NSE_CACHE=1
# NSE_LIVE_TTL=30
# End-of-day data lives this many seconds between 16:00 and 22:00 India time, and otherwise:
# NSE_EOD_TTL_PUBLISH=900
# NSE_EOD_TTL_IDLE=21600
